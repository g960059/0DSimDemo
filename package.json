{
  "name": "circleheart",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude __tests__/firestoreRules.emulator.test.ts",
    "test:all": "CIRCLEHEART_HEAVY_TESTS=1 vitest run --exclude __tests__/firestoreRules.emulator.test.ts",
    "test:heavy": "CIRCLEHEART_HEAVY_TESTS=1 vitest run --exclude __tests__/firestoreRules.emulator.test.ts engine/__tests__/guytonStarlingWorkerCore.test.ts engine/__tests__/starlingLowPreloadDebug.test.ts",
    "test:rules": "vitest run __tests__/firestoreRules.emulator.test.ts",
    "test:watch": "vitest",
    "verify:baseline": "vite-node tools/verifyBaseline.ts",
    "verify:cases": "vite-node tools/verifyCases.ts",
    "verify:guyton-starling": "vite-node tools/verifyGuytonStarling.ts",
    "verify:starling-low-preload-matrix": "STARLING_LOW_PRELOAD_MATRIX_MAIN=1 vite-node tools/verifyStarlingLowPreloadMatrix.ts",
    "debug:starling-low-preload": "STARLING_LOW_PRELOAD_DEBUG_MAIN=1 vite-node tools/debugStarlingLowPreload.ts",
    "fit:left-filling": "vite-node tools/fitLeftFilling.ts",
    "fit:right-pvf-headroom": "vite-node tools/fitRightPvfHeadroom.ts"
  },
  "dependencies": {
    "@blocknote/core": "^0.51.3",
    "@blocknote/mantine": "^0.51.3",
    "@blocknote/react": "^0.51.3",
    "d3": "^7.9.0",
    "dockview": "^6.6.1",
    "firebase": "^12.14.0",
    "i18next": "^26.3.1",
    "katex": "^0.17.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^17.0.8",
    "react-katex": "^3.1.0",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.14.0",
    "@types/react-katex": "^3.0.4",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.9"
  }
}
