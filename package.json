{
  "name": "circleheart",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check:repository-hygiene": "node tools/repository/checkRepositoryHygiene.mjs",
    "test": "npm run test:fast",
    "test:fast": "node tools/testing/runFastVitest.mjs",
    "test:pr": "CIRCLEHEART_TEST_SUITE_LABEL='PR smoke suite' CIRCLEHEART_VITEST_CONFIG=vitest.pr.config.ts node tools/testing/runFastVitest.mjs",
    "test:related": "vitest related --run --config vitest.fast.config.ts",
    "test:suites:audit": "vitest run --config vitest.fast.config.ts __tests__/testSuiteManifest.test.ts",
    "test:regression": "vitest run --config vitest.regression.config.ts",
    "test:scientific:canonical": "vitest run --config vitest.canonical.config.ts",
    "test:heavy": "CIRCLEHEART_HEAVY_TESTS=1 vitest run --config vitest.heavy.config.ts",
    "test:nightly": "npm run test:regression && npm run test:scientific:canonical && npm run test:heavy",
    "test:all": "npm run test:suites:audit && npm run test:fast && npm run test:regression && npm run test:scientific:canonical && npm run test:heavy",
    "test:rules": "vitest run __tests__/firestoreRules.emulator.test.ts",
    "test:watch": "vitest --config vitest.fast.config.ts",
    "test:watch:all": "vitest --config vitest.config.ts",
    "test:e2e:browser": "playwright test --config playwright.e2e.config.ts",
    "test:e2e:browser:pr": "playwright test --config playwright.e2e.config.ts --grep-invert @full-e2e",
    "test:e2e:browser:headed": "playwright test --config playwright.e2e.config.ts --headed",
    "install:e2e:chromium": "playwright install chromium",
    "benchmark:scientific:session": "vite-node --script tools/scientific/benchmarkMainWireScientificSessionV1.ts",
    "benchmark:coronary:v2-atomic-step": "vite-node --script tools/coronary/benchmarkMainWireFiveWallCoronaryTransactionV2.ts",
    "run:coronary:v2-periodic": "vite-node --script tools/coronary/runMainWireFiveWallCoronaryPeriodicSteadyV2.ts",
    "characterize:scientific:fast-tbv-accuracy": "vite-node --script tools/scientific/characterizeMainWireScientificFastTbvAccuracyV1.ts",
    "generate:scientific:main-wire-release": "vite-node --script tools/scientific/generateMainWireAdultFiveWallNonCoronaryReleaseV1.ts",
    "verify:scientific:main-wire-release": "vite-node --script tools/scientific/generateMainWireAdultFiveWallNonCoronaryReleaseV1.ts --check",
    "generate:scientific:official-healthy-periodic-checkpoint": "vite-node --script tools/scientific/generateOfficialHealthyPeriodicCheckpointPresetV1.ts",
    "verify:scientific:official-healthy-periodic-checkpoint": "vite-node --script tools/scientific/verifyOfficialHealthyPeriodicCheckpointPresetV1.ts",
    "generate:scientific:official-healthy-document-chain": "vite-node --script tools/scientific/generateOfficialHealthyPeriodicDocumentChainV1.ts",
    "verify:scientific:official-healthy-document-chain": "vite-node --script tools/scientific/generateOfficialHealthyPeriodicDocumentChainV1.ts --check",
    "generate:scientific:healthy-reference-acceptance": "vite-node --script tools/scientific/generateMainWireOfficialHealthyReferenceAcceptanceV1.ts",
    "verify:scientific:healthy-reference-acceptance": "vite-node --script tools/scientific/generateMainWireOfficialHealthyReferenceAcceptanceV1.ts --check",
    "generate:scientific:circulatory-load-envelope": "vite-node --script tools/scientific/generateMainWireCirculatoryLoadSensitivityEnvelopeV1.ts",
    "verify:scientific:circulatory-load-envelope": "vite-node --script tools/scientific/generateMainWireCirculatoryLoadSensitivityEnvelopeV1.ts --check",
    "generate:scientific:macro-physiology-envelope": "vite-node --script tools/scientific/generateMainWireMacroPhysiologyEnvelopeV1.ts",
    "verify:scientific:macro-physiology-envelope": "vite-node --script tools/scientific/generateMainWireMacroPhysiologyEnvelopeV1.ts --check",
    "verify:scientific:valve-preset-numerical-envelope": "vite-node --script tools/scientific/runMainWireValvePresetNumericalRobustnessEnvelopeV1.ts",
    "verify:scientific:browser-bundle-boundary": "node tools/scientific/verifyBrowserScientificBundleBoundaryV1.mjs",
    "verify:scientific:integrated-generated-v2": "vite-node --script tools/scientific/runMainWireIntegratedModelNumericalVerificationV2.ts",
    "verify:scientific:integrated-periodic-v2": "vite-node --script tools/scientific/runMainWireIntegratedModelPeriodicSteadyV2.ts",
    "verify:scientific:integrated-periodic-v3": "vite-node --script tools/scientific/runMainWireIntegratedModelPeriodicSteadyV3.ts",
    "render:scientific:integrated-periodic-v3-svg": "vite-node --script tools/scientific/renderMainWireIntegratedModelPeriodicSteadyArtifactSvgV3.ts",
    "verify:scientific:integrated-checkpoint-local-dt-v1": "vite-node --script tools/scientific/runMainWireIntegratedModelCheckpointLocalDtRefinementV1.ts",
    "characterize:device:hmii-stanfield-mean-context:v1": "vite-node --script tools/scientific/runHeartMateIiStanfieldMeanOperatingPointContextV1.ts",
    "characterize:coronary:v3-reduced-pressure-step-numerical": "vite-node --script tools/scientific/runCoronaryV3ReducedPressureStepNumericalCharacterizationV1.ts",
    "characterize:coronary:v3-reduced-pressure-step-numerical:v2": "vite-node --script tools/scientific/runCoronaryV3ReducedPressureStepNumericalCharacterizationV2.ts --output artifacts/coronary-v3/reduced-pressure-step-numerical-v2.json",
    "characterize:coronary:v3-lesion-structural-cmd-directional:v1": "vite-node --script tools/scientific/runCoronaryV3LesionStructuralCmdDirectionalCharacterizationV1.ts --output artifacts/coronary-v3/lesion-structural-cmd-directional-v1.json",
    "characterize:coronary:v3-structural-cmd-active-reserve:v2": "vite-node --script tools/scientific/runCoronaryV3StructuralCmdActiveReserveCharacterizationV2.ts --output artifacts/coronary-v3/structural-cmd-active-reserve-v2.json",
    "render:coronary:v3-reduced-pressure-step-diagnostic:v1": "vite-node --script tools/scientific/renderCoronaryV3ReducedPressureStepArtifactsSvgV1.ts --v1-input artifacts/coronary-v3/reduced-pressure-step-numerical-v1.json --v2-input artifacts/coronary-v3/reduced-pressure-step-numerical-v2.json --output artifacts/coronary-v3/reduced-pressure-step-raw-diagnostic-v1.svg",
    "verify:baseline": "vite-node tools/verifyBaseline.ts",
    "verify:guyton-starling": "vite-node tools/verifyGuytonStarling.ts",
    "validate:mechanical-support:v1": "vite-node --script tools/devices/generateMechanicalSupportValidationV1.ts",
    "verify:starling-low-preload-matrix": "STARLING_LOW_PRELOAD_MATRIX_MAIN=1 vite-node tools/verifyStarlingLowPreloadMatrix.ts",
    "debug:starling-low-preload": "STARLING_LOW_PRELOAD_DEBUG_MAIN=1 vite-node tools/debugStarlingLowPreload.ts",
    "fit:left-filling": "vite-node tools/fitLeftFilling.ts",
    "fit:right-pvf-headroom": "vite-node tools/fitRightPvfHeadroom.ts"
  },
  "dependencies": {
    "@blocknote/core": "^0.51.3",
    "@blocknote/mantine": "^0.51.3",
    "@blocknote/react": "^0.51.3",
    "d3": "^7.9.0",
    "dockview": "^6.6.1",
    "firebase": "^12.14.0",
    "i18next": "^26.3.1",
    "katex": "^0.17.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^17.0.8",
    "react-katex": "^3.1.0",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.14.0",
    "@types/react-katex": "^3.0.4",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.9"
  }
}
