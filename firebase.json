{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/model-documents/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, s-maxage=300, must-revalidate"
          }
        ]
      },
      {
        "source": "!/@(assets)/**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "source": "/@(ja|en)/@(experiments|snapshots|login|me|dev|docs)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/@(ja|en)/@(experiments|snapshots|login|me|dev|docs)/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/@(ja|en)/@(me|dev)/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/@(ja|en)/articles/*/edit",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/@(ja|en)/articles/*/preview",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/@(ja|en)/courses/new",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/@(ja|en)/courses/*/edit",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/_locale",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/model-documents/**",
        "run": {
          "serviceId": "circleheart-public-content",
          "region": "asia-northeast1",
          "pinTag": true
        }
      },
      {
        "source": "/@(ja|en)/models",
        "run": {
          "serviceId": "circleheart-public-content",
          "region": "asia-northeast1",
          "pinTag": true
        }
      },
      {
        "source": "/@(ja|en)/models/**",
        "run": {
          "serviceId": "circleheart-public-content",
          "region": "asia-northeast1",
          "pinTag": true
        }
      },
      {
        "source": "/@(ja|en)/courses/new",
        "destination": "/index.html"
      },
      {
        "source": "/@(ja|en)/courses/*/edit",
        "destination": "/index.html"
      },
      {
        "source": "/@(ja|en)/courses",
        "run": {
          "serviceId": "circleheart-public-content",
          "region": "asia-northeast1",
          "pinTag": true
        }
      },
      {
        "source": "/@(ja|en)/courses/**",
        "run": {
          "serviceId": "circleheart-public-content",
          "region": "asia-northeast1",
          "pinTag": true
        }
      },
      {
        "source": "/api/v1/public/courses/**",
        "run": {
          "serviceId": "circleheart-public-content",
          "region": "asia-northeast1",
          "pinTag": true
        }
      },
      {
        "source": "/_locale",
        "run": {
          "serviceId": "circleheart-public-content",
          "region": "asia-northeast1",
          "pinTag": true
        }
      },
      {
        "source": "/@(ja|en)/articles/*/@(edit|preview)",
        "destination": "/index.html"
      },
      {
        "source": "/robots.txt",
        "run": {
          "serviceId": "circleheart-public-content",
          "region": "asia-northeast1",
          "pinTag": true
        }
      },
      {
        "source": "/sitemap.xml",
        "run": {
          "serviceId": "circleheart-public-content",
          "region": "asia-northeast1",
          "pinTag": true
        }
      },
      {
        "source": "/@(ja|en)",
        "run": {
          "serviceId": "circleheart-public-content",
          "region": "asia-northeast1",
          "pinTag": true
        }
      },
      {
        "source": "/@(ja|en)/",
        "run": {
          "serviceId": "circleheart-public-content",
          "region": "asia-northeast1",
          "pinTag": true
        }
      },
      {
        "source": "/api/v1/public/articles/*",
        "run": {
          "serviceId": "circleheart-public-content",
          "region": "asia-northeast1",
          "pinTag": true
        }
      },
      {
        "source": "/@(ja|en)/articles",
        "run": {
          "serviceId": "circleheart-public-content",
          "region": "asia-northeast1",
          "pinTag": true
        }
      },
      {
        "source": "/@(ja|en)/articles/*",
        "run": {
          "serviceId": "circleheart-public-content",
          "region": "asia-northeast1",
          "pinTag": true
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
