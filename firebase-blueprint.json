{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and role information.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "role", "createdAt"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "Learning path lesson.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "order": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "published"]
        },
        "authorId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["title", "content", "order", "status", "authorId", "createdAt", "updatedAt"]
    },
    "Case": {
      "title": "Official Case",
      "description": "Official simulation case.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "initialState": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "published"]
        },
        "authorId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["title", "description", "status", "authorId", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles and roles."
    },
    "lessons/{lessonId}": {
      "schema": { "$ref": "#/entities/Lesson" },
      "description": "Official Learning path materials."
    },
    "cases/{caseId}": {
      "schema": { "$ref": "#/entities/Case" },
      "description": "Official cases."
    }
  }
}
