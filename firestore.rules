rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function existing() { return resource.data; }
    function incoming() { return request.resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isSignedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    
    function isSuperAdmin() {
      // Allow specific email as the initial admin
      return request.auth != null && request.auth.token.email == 'g960059@gmail.com' && request.auth.token.email_verified == true;
    }
    
    function isAdmin() {
      return isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt']) &&
             data.keys().size() == 3 &&
             data.email is string && data.email.size() <= 200 &&
             data.role is string && (data.role == 'user' || data.role == 'admin') &&
             data.createdAt is timestamp;
    }
    
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && isAdmin();
      
      allow create: if isValidId(userId) && isSignedIn() && request.auth.uid == userId &&
                       isValidUser(incoming()) && 
                       (incoming().role == 'user' || isSuperAdmin()) &&
                       incoming().createdAt == request.time;
      
      allow update: if isValidId(userId) && isSignedIn() && 
                       isValidUser(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       (isAdmin() || 
                         (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['email']) && incoming().role == existing().role)
                       );
                       
      allow delete: if isValidId(userId) && isAdmin();
    }
    
    function isValidLesson(data) {
      return data.keys().hasAll(['title', 'content', 'order', 'status', 'authorId', 'createdAt', 'updatedAt']) &&
             data.keys().size() == 7 &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 500000 &&
             data.order is number &&
             data.status is string && (data.status == 'draft' || data.status == 'published') &&
             data.authorId is string && data.authorId.size() <= 128 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }
    
    match /lessons/{lessonId} {
      allow get: if isValidId(lessonId) && (isAdmin() || existing().status == 'published');
      allow list: if (isAdmin() || resource.data.status == 'published');
      
      allow create: if isValidId(lessonId) && isAdmin() &&
                       isValidLesson(incoming()) &&
                       incoming().authorId == request.auth.uid &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;
                       
      allow update: if isValidId(lessonId) && isAdmin() &&
                       isValidLesson(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().authorId == existing().authorId &&
                       incoming().updatedAt == request.time;
                       
      allow delete: if isValidId(lessonId) && isAdmin();
    }
    
    function isValidCase(data) {
      return data.keys().hasAll([
               'title', 'description', 'kind', 'content', 'status', 'visibility',
               'ownerId', 'schemaVersion', 'engineVersion', 'knobMappingVersion',
               'workspaceSchemaVersion', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'title', 'description', 'kind', 'content', 'status', 'visibility',
               'ownerId', 'schemaVersion', 'engineVersion', 'knobMappingVersion',
               'workspaceSchemaVersion', 'tags', 'source', 'derivedFrom',
               'createdAt', 'updatedAt', 'publishedAt'
             ]) &&
             data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 10000 &&
             data.kind is string && (data.kind == 'case' || data.kind == 'lesson' || data.kind == 'promptGenerated') &&
             data.content is string && data.content.size() <= 500000 &&
             data.status is string && (data.status == 'draft' || data.status == 'published' || data.status == 'archived') &&
             data.visibility is string && (data.visibility == 'private' || data.visibility == 'unlisted' || data.visibility == 'public' || data.visibility == 'official') &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             data.schemaVersion is number &&
             data.engineVersion is string && data.engineVersion.size() <= 80 &&
             data.knobMappingVersion is string && data.knobMappingVersion.size() <= 80 &&
             data.workspaceSchemaVersion is number &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 20)) &&
             (!('source' in data) || (data.source is string && data.source.size() <= 200)) &&
             (!('derivedFrom' in data) || (data.derivedFrom is string && data.derivedFrom.size() <= 128)) &&
             (!('publishedAt' in data) || data.publishedAt is timestamp) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isCaseOwner() {
      return isSignedIn() && existing().ownerId == request.auth.uid;
    }

    function canReadCase() {
      return isAdmin() ||
             (isSignedIn() && existing().ownerId == request.auth.uid) ||
             (
               existing().status == 'published' &&
               (existing().visibility == 'public' || existing().visibility == 'unlisted' || existing().visibility == 'official')
             );
    }

    function canListCase() {
      return isAdmin() ||
             (isSignedIn() && resource.data.ownerId == request.auth.uid) ||
             (
               resource.data.status == 'published' &&
               (resource.data.visibility == 'public' || resource.data.visibility == 'official')
             );
    }
    
    match /cases/{caseId} {
      allow get: if isValidId(caseId) && canReadCase();
      allow list: if canListCase();
      
      allow create: if isValidId(caseId) && isSignedIn() &&
                       isValidCase(incoming()) &&
                       incoming().ownerId == request.auth.uid &&
                       (incoming().visibility != 'official' || isAdmin()) &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;
                       
      allow update: if isValidId(caseId) && (isAdmin() || isCaseOwner()) &&
                       isValidCase(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().ownerId == existing().ownerId &&
                       ((incoming().visibility != 'official' && existing().visibility != 'official') || isAdmin()) &&
                       incoming().updatedAt == request.time;
                       
      allow delete: if isValidId(caseId) && (isAdmin() || isCaseOwner());
    }
  }
}
