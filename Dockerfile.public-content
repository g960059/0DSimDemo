FROM node:24-trixie-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build:public-content

FROM node:24-trixie-slim AS runtime

ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist
COPY --from=build /app/dist-public-content ./dist-public-content

USER node
EXPOSE 8080
CMD ["node", "dist-public-content/publicContentServerV1.js"]
