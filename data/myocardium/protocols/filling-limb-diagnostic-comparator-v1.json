{
  "schemaVersion": 1,
  "id": "filling-limb-diagnostic-comparator-v1",
  "status": "proposed",
  "claimBoundary": "off-by-default-diagnostic-comparison-only",
  "purpose": "Define the explicit-CLI artifact contract for comparing existing PV-loop morphology filling-limb diagnostic rows without changing model equations, solver behavior, official cases, default runtime behavior, UI/runtime wiring, or package scripts.",
  "relatedDocs": [
    "docs/myocardium/verification/filling-limb-diagnostic-comparator-v1.md",
    "docs/myocardium/verification/filling-limb-correlation-readiness-v1.md",
    "docs/myocardium/verification/filling-limb-artifact-audit-v1.md",
    "docs/myocardium/verification/pv-loop-morphology-quality.md"
  ],
  "dependsOn": [
    "data/myocardium/protocols/filling-limb-correlation-readiness-v1.json",
    "data/myocardium/protocols/filling-limb-artifact-audit-v1.json",
    "data/myocardium/protocols/pv-loop-morphology-quality-v1.json"
  ],
  "tool": {
    "path": "tools/myocardium/buildFillingLimbDiagnosticComparator.ts",
    "invocation": "npx vite-node tools/myocardium/buildFillingLimbDiagnosticComparator.ts -- --input=artifacts/myocardium/pv-loop-morphology/latest --out=artifacts/myocardium/pv-loop-morphology/latest/filling-limb-diagnostic-comparator",
    "packageScriptWiring": "forbidden",
    "defaultRuntimeWiring": "forbidden",
    "officialCaseWiring": "forbidden",
    "uiRuntimeWiring": "forbidden",
    "modelEquationChange": "forbidden",
    "solverBehaviorChange": "forbidden",
    "officialCaseParameterChange": "forbidden"
  },
  "inputArtifacts": [
    "summary.json",
    "per-case-metrics.csv"
  ],
  "outputArtifacts": [
    "summary.json",
    "summary.md",
    "filling-limb-comparator-groups.csv",
    "command.txt"
  ],
  "identityRequirements": {
    "requiredFields": [
      "caseId",
      "branchId",
      "beatIndex",
      "chamber",
      "samplingMode",
      "transitionPolicy"
    ],
    "rawBeforeResampled": true,
    "comparativeRawVsResampledRequired": true,
    "transitionInclusiveAndExcludedRequired": true
  },
  "primaryMetricIds": [
    "mvOpenLowerLimbRoughness",
    "tvOpenLowerLimbRoughness",
    "lowerLimbKinkCount",
    "valveOpenCloseChatterCount",
    "eventCorrelationWindowHitFraction"
  ],
  "antiGamingReadouts": [
    "endDiastolicVolumeM3",
    "strokeVolumeM3",
    "cardiacOutputM3PerSec",
    "meanLeftAtrialPressurePa",
    "meanRightAtrialPressurePa",
    "eaLikeInflowProxy",
    "inletForwardVolumeM3",
    "inletReverseVolumeM3",
    "qDotClampHitFraction",
    "valveDiodeClampHitFraction",
    "dynamicFlowClampHitFraction",
    "pressureFloorHitFraction",
    "atrialKickBoosterPreservation"
  ],
  "interpretabilityRule": "A comparator group is interpretable only when raw-before-resampled evidence, matched resampled evidence, transition-inclusive and transition-excluded-core evidence, and all anti-gaming readouts are available for the same caseId, branchId, beatIndex, chamber, samplingMode, and transitionPolicy identity. Missing fields must be reported as missing rather than inferred.",
  "claimExclusions": {
    "acceptedRootCause": "not-claimed",
    "fixAcceptance": "not-claimed",
    "officialMorphologyPass": "not-claimed",
    "productionRuntimeReadiness": "not-claimed",
    "defaultRuntimeAdoption": "not-claimed",
    "officialCaseWiring": "not-claimed"
  }
}
